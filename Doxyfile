#
# API reference for the public headers, and CI's check that every public
# symbol is documented. Run from the repository root:
#
#   doxygen            # HTML in build-doxygen/html; fails on a warning
#
# Options not set here keep Doxygen's defaults.

PROJECT_NAME           = TreLVis
PROJECT_BRIEF          = "Layout primitives, MD3 tokens and an MD3 theme for LVGL"
OUTPUT_DIRECTORY       = build-doxygen

INPUT                  = include/trelvis
FILE_PATTERNS          = *.h
STRIP_FROM_PATH        = include
OPTIMIZE_OUTPUT_FOR_C  = YES

# Document what is documented; warn about everything public that isn't.
EXTRACT_ALL            = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
